{
  "manifest_version": 3,
  "name": "MySQL Browser Client",
  "version": "0.2.9",
  "description": "Browse MySQL schemas and run controlled SQL through a local native host.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "clipboardWrite"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 MySQL Browser Client",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
